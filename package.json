{
  "name": "link-up",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "20",
    "pnpm": "9"
  },
  "scripts": {
    "postinstall": "pnpm --filter @fb/db generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fb/db generate",
    "db:migrate": "pnpm --filter @fb/db migrate:dev",
    "db:deploy": "pnpm --filter @fb/db migrate:deploy",
    "db:seed": "pnpm --filter @fb/db seed",
    "db:seed-players": "pnpm --filter @fb/db seed:players",
    "db:import-api-football": "pnpm --filter @fb/db import:api-football",
    "db:import-tournament-stats": "pnpm --filter @fb/db import:tournament-stats",
    "db:import-player-data": "pnpm --filter @fb/db import:player-data",
    "db:diff-import": "pnpm --filter @fb/db diff-import",
    "db:transliterate-names": "pnpm --filter @fb/db transliterate:names",
    "db:calculate-scores": "pnpm --filter @fb/db calculate:scores",
    "db:reset": "pnpm --filter @fb/db migrate:reset",
    "db:seed-bots": "pnpm --filter @fb/game-server seed:bots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^22.7.5",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0"
  }
}
