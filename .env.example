# Root example env — copy to each app/package as noted in the README.
# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://football:football@localhost:5432/football_poker?schema=public"

# Auth.js — generate with: openssl rand -base64 32  (or: npx auth secret)
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"

# API-Football (api-sports.io) — ONLY for the one-time player importer
# (pnpm db:import-api-football). Put the real key in packages/db/.env (gitignored);
# never commit it. Placeholder only here.
API_FOOTBALL_KEY="your-api-football-key"

# Email (Resend) — OTP email verification on signup. Set on the WEB service.
# RESEND_API_KEY: create at resend.com → API Keys.
# EMAIL_FROM: must be on a Resend-VERIFIED sending domain. We use a dedicated
#   mail subdomain (mail.fmgtech.dev) whose DNS is isolated from the live game
#   domain, so its SPF/DKIM records don't touch game1.fmgtech.dev.
RESEND_API_KEY="re_replace-me"
EMAIL_FROM="Football B <no-reply@mail.fmgtech.dev>"
