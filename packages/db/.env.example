# @fb/db — copy to packages/db/.env for Prisma CLI (migrate/seed/studio).
DATABASE_URL="postgresql://football:football@localhost:5432/football_poker?schema=public"

# Optional separate database for the wallet test suite (recommended).
# If unset, the tests fall back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://football:football@localhost:5432/football_poker_test?schema=public"

# API-Football key for the one-time importer (pnpm db:import-api-football).
# Put your REAL key in packages/db/.env (gitignored) — never commit it.
API_FOOTBALL_KEY="your-api-football-key"
