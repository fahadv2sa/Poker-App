// Football Poker — database schema (Section 5 of SPEC.md).
// Conventions: all PKs are uuid; all timestamps are timestamptz; tables and
// columns are snake_case via @@map/@map. Only Positions + HandRanks are seeded;
// no real football player is ever inserted (data-driven, Section 17).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries use the pooled URL; Prisma Migrate uses the direct one.
  // For Railway PostgreSQL both point at the same connection string; the split
  // lets a future move to Neon (pooled vs direct) happen with no code change.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum WalletTxType {
  SIGNUP_BONUS
  BANK_CLAIM
  ANTE
  BET
  RAISE
  ALLIN
  WIN
  SPLIT_WIN
  REFUND
  FOLD_FORFEIT
  INSTALL_REWARD

  @@map("wallet_tx_type")
}

enum PositionCode {
  GK
  DEF
  MID
  FWD

  @@map("position_code")
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  ENDED
  ABANDONED

  @@map("game_status")
}

// How a room was created. MANUAL rooms (from إنشاء غرفة) are publicly listed and
// allow rejoin while open; QUICK_PLAY rooms are matchmaking-only — never listed
// and never rejoinable once a player leaves. This is the authoritative room-type
// flag; never infer the type from isPrivate or the room name.
enum GameKind {
  MANUAL
  QUICK_PLAY

  @@map("game_kind")
}

enum GamePhase {
  LOBBY
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  RESOLVE
  ENDED

  @@map("game_phase")
}

enum GamePlayerStatus {
  WAITING
  ACTIVE
  FOLDED
  ALLIN
  DISCONNECTED

  @@map("game_player_status")
}

enum CardType {
  HOLE
  COMMUNITY

  @@map("card_type")
}

enum BetRound {
  PREFLOP
  FLOP
  TURN
  RIVER

  @@map("bet_round")
}

enum BetAction {
  ANTE
  CHECK
  CALL
  RAISE
  FOLD
  ALLIN

  @@map("bet_action")
}

enum ResultOutcome {
  WIN
  SPLIT
  LOSE
  FOLD
  REFUND

  @@map("result_outcome")
}

// Big-tournament categories tracked per player for the fame score (display/
// difficulty only — never used by the rank engine).
enum TournamentType {
  WORLD_CUP
  EURO_COPA
  CHAMPIONS_LEAGUE

  @@map("tournament_type")
}

// Room difficulty — selects the fame_score floor the deal draws from (Part 3).
// Three levels: EASY (floor>=70), MEDIUM (floor>=50), ELITE (all active).
enum Difficulty {
  EASY
  MEDIUM
  ELITE

  @@map("difficulty")
}

// ----------------------------------------------------------------------------
// Identity, wallet, stats (persistent)
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Sequential, starts at 100001 (sequence restart set in the init migration),
  // displayed as e.g. #100001.
  playerNumber Int      @unique @default(autoincrement()) @map("player_number")
  username     String   @unique
  // Editable display name (profile layer). NOT unique — `username`/`playerNumber`
  // remain the identifiers; null falls back to `username` for display.
  nickname     String?
  passwordHash String   @map("password_hash") // argon2id
  // Email + OTP verification. `email` is collected at signup and unique; nullable
  // ONLY so pre-existing rows (no email) stay valid — new signups always set it.
  // `emailVerifiedAt` is the login gate: NULL = unverified (login is blocked and
  // the user is routed to /verify). The init-verification migration backfills all
  // existing rows to now() so the handful of legacy/test accounts are grandfathered
  // as verified and never sent through the flow.
  email           String?   @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  avatarSeed   String?  @map("avatar_seed")
  // Social layer: denormalized total likes received (source of truth = Like rows).
  likesReceived Int     @default(0) @map("likes_received")
  // Inactivity auto-logout: last time this human showed activity (HTTP request or
  // socket event). Advanced by touchUserActivity (throttled); read at access to
  // expire sessions idle > SESSION_INACTIVITY_MS. Defaults to now() so existing
  // rows backfill to migration time (nobody is logged out on deploy). Bots have
  // a row too but it is never updated or checked (they never authenticate).
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  // One-time "add to home screen" reward: set when the 10k install reward is
  // granted (null = never claimed). Persists across uninstall/reinstall so the
  // reward can be granted at most once per account.
  installRewardAt DateTime? @map("install_reward_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet       Wallet?
  stats        UserStats?
  metrics      PlayerMetrics?
  avatar       UserAvatar?
  transactions WalletTransaction[]
  bankClaims   BankClaim[]
  gamesCreated Game[]              @relation("GamesCreatedBy")
  gamePlayers  GamePlayer[]
  playEvents   PlayEvent[]
  playerBadges PlayerBadge[]
  likesGiven    Like[]       @relation("LikesGiven")
  likesGot      Like[]       @relation("LikesGot")
  friendReqSent Friendship[] @relation("FriendRequester")
  friendReqRecv Friendship[] @relation("FriendAddressee")
  emailOtp      EmailOtp?

  @@map("users")
}

// One-time email-verification code (signup OTP). At most ONE active code per user
// (user_id is unique) — a re-request UPSERTS this row, so codes never accumulate;
// the row count is bounded by the number of currently-unverified users. The
// 6-digit code is stored ONLY as a hash (HMAC-SHA256 over AUTH_SECRET), never in
// plaintext. Lifecycle (data-hygiene): deleted on successful verify, and expired
// rows are purged opportunistically on each issue/verify. `expiresAt` is at most
// 5 minutes out; `attempts` caps brute-force guesses before the code is killed.
model EmailOtp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports the opportunistic purge (DELETE WHERE expires_at < now()).
  @@index([expiresAt])
  @@map("email_otps")
}

// Social — likes (one row per (liker, target); one-per-user toggle). Denormalized
// count lives on User.likesReceived, moved in lockstep with these rows.
model Like {
  id        String   @id @default(uuid()) @db.Uuid
  likerId   String   @map("liker_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  liker     User     @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  target    User     @relation("LikesGot", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([likerId, targetId])
  @@index([targetId])
  @@map("likes")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("friend_status")
}

// Social — directional friend request with an approval state machine. One row per
// (requester, addressee). A friendship is ACTIVE only when status=ACCEPTED.
// Overlapping/duplicate requests + self-requests are rejected/auto-handled in code.
model Friendship {
  id          String       @id @default(uuid()) @db.Uuid
  requesterId String       @map("requester_id") @db.Uuid
  addresseeId String       @map("addressee_id") @db.Uuid
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  // balance is updated ONLY in sync with inserting a WalletTransaction, inside
  // the same DB transaction. A CHECK(balance >= 0) is added in the migration.
  balance        BigInt   @default(1000)
  highestBalance BigInt   @default(1000) @map("highest_balance")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// Append-only ledger — the financial source of truth (Section 6).
model WalletTransaction {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  gameId       String?      @map("game_id") @db.Uuid
  type         WalletTxType
  amount       BigInt // positive = credit, negative = debit
  balanceAfter BigInt       @map("balance_after")
  reference    String       @unique // = server-generated idempotency key (actionId)
  metadata     Json?        @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  // Makes the SetNull during an abandoned-game delete index-driven (was a
  // seq-scan); also useful for any per-game ledger lookup. Additive.
  @@index([gameId])
  @@map("wallet_transactions")
}

model BankClaim {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    BigInt   @default(1000)
  // Claim-log fields (level-based daily claim): the player's level at claim time
  // and the wallet balance right after crediting. Nullable — rows created before
  // this was introduced have neither. Filled by claimFromBank.
  level         Int?
  balanceAfter  BigInt?  @map("balance_after")
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, claimedAt])
  @@map("bank_claims")
}

model UserStats {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  gamesPlayed    Int      @default(0) @map("games_played")
  wins           Int      @default(0)
  losses         Int      @default(0)
  folds          Int      @default(0)
  totalCoinsWon  BigInt   @default(0) @map("total_coins_won")
  totalCoinsLost BigInt   @default(0) @map("total_coins_lost")
  netProfitLoss  BigInt   @default(0) @map("net_profit_loss")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// Uploaded profile avatar (profile layer). Stored in the DB (Railway's filesystem
// is ephemeral) — small images only. Served by user_id so other players' avatars
// work later. Absent ⇒ the UI shows a generated avatar from `avatar_seed`.
model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  data      Bytes
  mimeType  String   @map("mime_type")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// ============================================================================
// Statistics & progression (4-layer system). All keyed on the stable User.id,
// independent of any future profile layer. Append-only events (Layer 1) →
// incremental per-player metrics (Layer 2) → data-driven badges (Layer 3) →
// composite XP/level (Layer 4). Live play writes lightweight PlayEvent rows
// only; all aggregation runs after the hand, outside the betting hot path.
// ============================================================================

// Layer 1 — raw, append-only event log (same philosophy as the wallet ledger).
enum PlayEventType {
  BET // a wager: value = amount, metadata.potBefore for bet/pot ratio
  RAISE
  CALL
  CHECK
  FOLD
  ALLIN
  // One per dealt player at resolve — the unit the aggregator folds into
  // metrics. metadata carries the derived per-hand facts (won, folded, showdown,
  // rankStrength, dealtStrength, luck, maxBetToPot, isBluff, bluffWon, weakWon…).
  ROUND_SUMMARY

  @@map("play_event_type")
}

model PlayEvent {
  // Monotonic watermark for incremental, idempotent aggregation.
  seq        BigInt        @id @default(autoincrement())
  playerId   String        @map("player_id") @db.Uuid
  gameId     String?       @map("game_id") @db.Uuid
  handNumber Int           @map("hand_number")
  type       PlayEventType
  value      Float?
  metadata   Json?         @db.JsonB
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  player     User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game       Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([playerId, seq])
  @@index([playerId, createdAt])
  @@index([gameId, handNumber])
  @@map("play_events")
}

// Layer 2 — precomputed per-player read model. Updated AFTER a hand, incrementally
// (only over events past `lastSeq`). The stats page reads straight from here.
model PlayerMetrics {
  userId            String   @id @map("user_id") @db.Uuid
  matches           Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  folds             Int      @default(0)
  netProfit         BigInt   @default(0) @map("net_profit")
  totalWon          BigInt   @default(0) @map("total_won")
  totalLost         BigInt   @default(0) @map("total_lost")
  showdownCount     Int      @default(0) @map("showdown_count")
  bluffCount        Int      @default(0) @map("bluff_count")
  bluffSuccessCount Int      @default(0) @map("bluff_success_count")
  weakWonCount      Int      @default(0) @map("weak_won_count")
  // Sums for averages (kept incrementally so rates need no event re-scan).
  betToPotSum       Float    @default(0) @map("bet_to_pot_sum")
  betActionCount    Int      @default(0) @map("bet_action_count")
  luckSum           Float    @default(0) @map("luck_sum")
  luckRounds        Int      @default(0) @map("luck_rounds")
  biggestPot        BigInt   @default(0) @map("biggest_pot")
  // Biggest single-hand net win / loss (profile layer; filled by the aggregator).
  biggestWin        BigInt   @default(0) @map("biggest_win")
  biggestLoss       BigInt   @default(0) @map("biggest_loss")
  currentWinStreak  Int      @default(0) @map("current_win_streak")
  longestWinStreak  Int      @default(0) @map("longest_win_streak")
  // Layer 4 — composite progression.
  xp                BigInt   @default(0)
  level             Int      @default(1)
  // Highest level the player has already seen the "level up" celebration for.
  // The web shows the celebration when `level > celebrated_level`, then advances
  // this (server-authoritative, once per level-up). Defaults to 1; the migration
  // backfills existing rows to their current level so nobody is celebrated
  // retroactively.
  celebratedLevel   Int      @default(1) @map("celebrated_level")
  // Watermark: the highest PlayEvent.seq folded in so far (idempotent/incremental).
  lastSeq           BigInt   @default(0) @map("last_seq")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_metrics")
}

// Layer 3 — data-driven badge definitions (same pattern as HandRank). Add a new
// badge by inserting a row — no code change. `rule` is the condition DSL over
// PlayerMetrics-derived fields.
model Badge {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  nameAr        String        @map("name_ar")
  descriptionAr String        @map("description_ar")
  icon          String        @default("🏅")
  sortOrder     Int           @default(0) @map("sort_order")
  active        Boolean       @default(true)
  rule          Json          @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  awards        PlayerBadge[]

  @@map("badges")
}

// Awarded badges — idempotent (a badge is granted once per player).
model PlayerBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("player_badges")
}

// ----------------------------------------------------------------------------
// Football reference data (data-driven; owner-supplied except Positions seed)
// ----------------------------------------------------------------------------

model Nationality {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  isoCode   String? @map("iso_code")
  flagEmoji String? @map("flag_emoji")

  clubs     Club[]
  players   Player[]

  @@map("nationalities")
}

model Position {
  id      String       @id @default(uuid()) @db.Uuid
  code    PositionCode @unique
  nameAr  String       @map("name_ar")
  nameEn  String       @map("name_en")

  players Player[]

  @@map("positions")
}

// Team entity type. Career history (player_clubs) holds ONLY kind=CLUB; national
// teams (senior/youth) and youth-club academies are split into their own link
// tables. Display/data only — the rank engine still keys on player_clubs.
enum ClubKind {
  CLUB
  NATIONAL_TEAM
  NATIONAL_YOUTH
  YOUTH_CLUB

  @@map("club_kind")
}

model Club {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  countryId   String?      @map("country_id") @db.Uuid
  logoUrl     String?      @map("logo_url")
  // Entity type (see ClubKind): separates real clubs from national teams and
  // youth-club academies so career history can be clubs-only.
  kind        ClubKind     @default(CLUB)

  country       Nationality?         @relation(fields: [countryId], references: [id], onDelete: SetNull)
  playerClubs   PlayerClub[]
  nationalTeams PlayerNationalTeam[]
  youthClubs    PlayerYouthClub[]

  @@map("clubs")
}

model Player {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  // Arabic display name (Batch 2). Display-only — NEVER used in rank logic, which
  // keys on nationality/position/clubs. Nullable so existing rows stay valid.
  nameAr        String?  @map("name_ar")
  // External provider id (e.g. API-Football player id). Idempotency key for the
  // one-time importer; null for manually-seeded players. Display/data only.
  externalRef   Int?     @unique @map("external_ref")
  nationalityId String   @map("nationality_id") @db.Uuid
  positionId    String   @map("position_id") @db.Uuid
  birthYear     Int?     @map("birth_year")
  photoUrl      String?  @map("photo_url")
  // Static per-player data imported from API-Football (display/data only — NEVER
  // used by the rank engine, which keys on nationality/position/clubs). All
  // nullable so existing rows stay valid until enriched.
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  birthDate     DateTime? @map("birth_date") @db.Date
  birthPlace    String?   @map("birth_place")
  birthCountry  String?   @map("birth_country")
  heightCm      Int?      @map("height_cm")
  weightKg      Int?      @map("weight_kg")
  active        Boolean  @default(true)
  // Legend flag (display/curation only — never used by the rank engine, wallet,
  // or card privacy). The fame-score "legend" component stays 0 for everyone
  // until that scoring rule is activated separately.
  isLegend      Boolean  @default(false) @map("is_legend")
  // Legend-card score: the raw fame_score mapped into the legend range
  // [80, 95] via 80 + 15*(fame_score/100); Messi=100, Ronaldo=99 override.
  // Null for non-legends. fame_score keeps the raw value untouched.
  legendScore   Float?   @map("legend_score")
  // Fame system (display + difficulty tiers only — NEVER used by the rank
  // engine, which keys on nationality/position/clubs). Filled by the import +
  // calculate scripts; both nullable/0 until then so existing rows stay valid.
  top5LeagueSeasons Int    @default(0) @map("top5_league_seasons")
  fameScore         Float? @map("fame_score")
  // Fame tier 1-4 (1 = most famous), derived from fame_score rank by
  // calculate-scores. Drives the difficulty dealing filter (Part 3).
  tier              Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  nationality     Nationality            @relation(fields: [nationalityId], references: [id], onDelete: Restrict)
  position        Position               @relation(fields: [positionId], references: [id], onDelete: Restrict)
  playerClubs     PlayerClub[]
  nationalTeams   PlayerNationalTeam[]
  youthClubs      PlayerYouthClub[]
  tournamentStats PlayerTournamentStat[]
  seasonStats     PlayerSeasonStat[]
  gameCards       GameCard[]

  @@index([nationalityId])
  @@index([positionId])
  @@index([tier])
  @@map("players")
}

// One row per (player, tournament type) holding an appearance count, sourced by
// the API-Football tournament-stats import. Feeds COMPONENT 3 of the fame score.
model PlayerTournamentStat {
  id             String         @id @default(uuid()) @db.Uuid
  playerId       String         @map("player_id") @db.Uuid
  tournamentType TournamentType @map("tournament_type")
  appearances    Int            @default(0)

  player         Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentType])
  @@index([playerId])
  @@map("player_tournament_stats")
}

// SEASON-/COMPETITION-dependent stats from API-Football's /players?id=&season=
// `statistics[]` — one row per (player, season, competition, team). Fully
// columnized (every nested field flattened) so the data is structured and
// searchable, nothing discarded. Display/data only — NEVER used by the rank
// engine, wallet, or card privacy. Mirrors our existing conventions (uuid PK,
// snake_case @@map, timestamptz). External ids are the API-Football ids.
model PlayerSeasonStat {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  season   Int

  // team + league/competition this stat line belongs to (API ids + display)
  teamId        Int?    @map("team_id")
  teamName      String? @map("team_name")
  teamLogo      String? @map("team_logo")
  leagueId      Int?    @map("league_id")
  leagueName    String? @map("league_name")
  leagueCountry String? @map("league_country")
  leagueLogo    String? @map("league_logo")
  leagueFlag    String? @map("league_flag")

  // games
  appearances Int?     @map("games_appearances")
  lineups     Int?     @map("games_lineups")
  minutes     Int?     @map("games_minutes")
  shirtNumber Int?     @map("games_number")
  position    String?  @map("games_position")
  rating      Float?   @map("games_rating")
  captain     Boolean? @map("games_captain")

  // substitutes
  subsIn    Int? @map("subs_in")
  subsOut   Int? @map("subs_out")
  subsBench Int? @map("subs_bench")

  // shots
  shotsTotal Int? @map("shots_total")
  shotsOn    Int? @map("shots_on")

  // goals
  goalsTotal    Int? @map("goals_total")
  goalsConceded Int? @map("goals_conceded")
  goalsAssists  Int? @map("goals_assists")
  goalsSaves    Int? @map("goals_saves")

  // passes
  passesTotal    Int? @map("passes_total")
  passesKey      Int? @map("passes_key")
  passesAccuracy Int? @map("passes_accuracy")

  // tackles
  tacklesTotal         Int? @map("tackles_total")
  tacklesBlocks        Int? @map("tackles_blocks")
  tacklesInterceptions Int? @map("tackles_interceptions")

  // duels
  duelsTotal Int? @map("duels_total")
  duelsWon   Int? @map("duels_won")

  // dribbles
  dribblesAttempts Int? @map("dribbles_attempts")
  dribblesSuccess  Int? @map("dribbles_success")
  dribblesPast     Int? @map("dribbles_past")

  // fouls
  foulsDrawn     Int? @map("fouls_drawn")
  foulsCommitted Int? @map("fouls_committed")

  // cards
  cardsYellow    Int? @map("cards_yellow")
  cardsYellowRed Int? @map("cards_yellowred")
  cardsRed       Int? @map("cards_red")

  // penalty
  penaltyWon       Int? @map("penalty_won")
  penaltyCommitted Int? @map("penalty_committed")
  penaltyScored    Int? @map("penalty_scored")
  penaltyMissed    Int? @map("penalty_missed")
  penaltySaved     Int? @map("penalty_saved")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, leagueId, teamId])
  @@index([playerId])
  @@index([season])
  @@index([leagueId])
  @@map("player_season_stats")
}

model PlayerClub {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid
  fromYear Int?   @map("from_year")
  toYear   Int?   @map("to_year")

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([clubId])
  @@map("player_clubs")
}

// National-team appearances (المنتخب), split out of player_clubs. Each row's
// club is a kind=NATIONAL_TEAM (senior) or NATIONAL_YOUTH entity. Preserved and
// queryable; not part of the club career history and not seen by the engine.
model PlayerNationalTeam {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubId])
  @@index([playerId])
  @@index([clubId])
  @@map("player_national_teams")
}

// Youth-club academy appearances (e.g. "Real Madrid U19"), split out of
// player_clubs. Each row's club is a kind=YOUTH_CLUB entity. Preserved.
model PlayerYouthClub {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubId])
  @@index([playerId])
  @@index([clubId])
  @@map("player_youth_clubs")
}

// Game rules, seeded. rule (jsonb) holds the Rule DSL (Section 7.3/7.4).
model HandRank {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  nameAr        String  @map("name_ar")
  nameEn        String  @map("name_en")
  strength      Int     @unique
  rule          Json    @db.JsonB
  descriptionAr String? @map("description_ar")
  examples      Json?   @db.JsonB
  active        Boolean @default(true)

  claimsAsClaimed PlayerHandClaim[] @relation("ClaimedHandRank")
  claimsAsBest    PlayerHandClaim[] @relation("BestPossibleRank")

  @@map("hand_ranks")
}

// ----------------------------------------------------------------------------
// Game session (rooms are temporary; results/ledger are persistent)
// ----------------------------------------------------------------------------

model Game {
  id              String     @id @default(uuid()) @db.Uuid
  roomName        String     @map("room_name")
  isPrivate       Boolean    @default(false) @map("is_private")
  kind            GameKind   @default(MANUAL)
  maxPlayers      Int        @map("max_players")
  inviteCode      String     @unique @map("invite_code")
  status          GameStatus @default(LOBBY)
  difficulty      Difficulty @default(MEDIUM)
  createdBy       String     @map("created_by") @db.Uuid
  config          Json       @db.JsonB
  phase           GamePhase  @default(LOBBY)
  pot             BigInt     @default(0) // display total
  pots            Json?      @db.JsonB // side pots at resolve: [{ amount, eligibleSeats[] }]
  currentBet      BigInt     @default(0) @map("current_bet")
  dealerSeat      Int?       @map("dealer_seat")
  currentTurnSeat Int?       @map("current_turn_seat")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(6)

  creator         User       @relation("GamesCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  players         GamePlayer[]
  cards           GameCard[]
  bets            Bet[]
  handClaims      PlayerHandClaim[]
  results         GameResult[]
  transactions    WalletTransaction[]
  playEvents      PlayEvent[]

  // Supports the abandoned-room cleanup selection (status='ABANDONED' AND
  // ended_at < cutoff). Additive; no data change.
  @@index([status, endedAt])
  @@map("games")
}

model GamePlayer {
  id                 String           @id @default(uuid()) @db.Uuid
  gameId             String           @map("game_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  seat               Int
  status             GamePlayerStatus @default(WAITING)
  holeCards          Json?            @map("hole_cards") @db.JsonB // server only, never broadcast
  committedTotal     BigInt           @default(0) @map("committed_total")
  committedThisRound BigInt           @default(0) @map("committed_this_round")
  lastBetAmount      BigInt           @default(0) @map("last_bet_amount")
  joinedAt           DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime?        @map("left_at") @db.Timestamptz(6)

  game               Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets               Bet[]
  handClaims         PlayerHandClaim[]
  results            GameResult[]

  @@unique([gameId, seat])
  @@unique([gameId, userId])
  @@map("game_players")
}

model GameCard {
  id               String   @id @default(uuid()) @db.Uuid
  gameId           String   @map("game_id") @db.Uuid
  cardType         CardType @map("card_type")
  ownerSeat        Int?     @map("owner_seat")
  communityIndex   Int?     @map("community_index") // 0-4
  footballPlayerId String   @map("football_player_id") @db.Uuid
  revealed         Boolean  @default(false)

  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  footballPlayer   Player   @relation(fields: [footballPlayerId], references: [id], onDelete: Restrict)

  @@index([gameId])
  @@map("game_cards")
}

model Bet {
  id           String    @id @default(uuid()) @db.Uuid
  gameId       String    @map("game_id") @db.Uuid
  gamePlayerId String    @map("game_player_id") @db.Uuid
  round        BetRound
  action       BetAction
  amount       BigInt
  sequence     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("bets")
}

model PlayerHandClaim {
  id                 String   @id @default(uuid()) @db.Uuid
  gameId             String   @map("game_id") @db.Uuid
  gamePlayerId       String   @map("game_player_id") @db.Uuid
  claimedHandRankId  String?  @map("claimed_hand_rank_id") @db.Uuid
  isValid            Boolean  @map("is_valid")
  bestPossibleRankId String?  @map("best_possible_rank_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  game               Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer         GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  claimedHandRank    HandRank?  @relation("ClaimedHandRank", fields: [claimedHandRankId], references: [id], onDelete: SetNull)
  bestPossibleRank   HandRank?  @relation("BestPossibleRank", fields: [bestPossibleRankId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@map("player_hand_claims")
}

model GameResult {
  id           String        @id @default(uuid()) @db.Uuid
  gameId       String        @map("game_id") @db.Uuid
  gamePlayerId String        @map("game_player_id") @db.Uuid
  outcome      ResultOutcome
  coinsDelta   BigInt        @map("coins_delta")
  finalBalance BigInt        @map("final_balance")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_results")
}
