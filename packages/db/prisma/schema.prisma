// Football B — database schema, shared platform DB (Section 5 of SPEC.md).
// Conventions: all PKs are uuid; all timestamps are timestamptz; tables and
// columns are snake_case via @@map/@map. Only Positions + HandRanks are seeded;
// no real football player is ever inserted (data-driven, Section 17).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection string no longer lives here. Runtime queries go
  // through the pg driver adapter (pooled DATABASE_URL, see src/client.ts); the
  // CLI/Migrate reads the direct URL from prisma.config.ts (DIRECT_URL, falling
  // back to DATABASE_URL). The split lets a future move to Neon (pooled vs
  // direct) happen with no code change.
  //
  // Multi-game isolation: tables live in per-owner schemas (binding contract in
  // docs/architecture/PLATFORM_CONTRACTS.md). platform = identity/social (A),
  // football = reference data (B), link_up = Link Up's economy + session (C+D).
  // A future game takes its own schema; A+B stay shared.
  schemas   = ["platform", "football", "link_up", "top_10", "guess_player"]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum WalletTxType {
  SIGNUP_BONUS
  BANK_CLAIM
  ANTE
  BET
  RAISE
  ALLIN
  WIN
  SPLIT_WIN
  REFUND
  FOLD_FORFEIT
  INSTALL_REWARD
  // Manual balance correction made by an admin via the dashboard. Goes through
  // the SAME append-only ledger primitive (row lock + idempotency) — never a
  // direct balance write — so wallet integrity (Section 6) is preserved.
  ADMIN_ADJUST

  @@map("wallet_tx_type")
  @@schema("link_up")
}

enum PositionCode {
  GK
  DEF
  MID
  FWD

  @@map("position_code")
  @@schema("football")
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  ENDED
  ABANDONED

  @@map("game_status")
  @@schema("link_up")
}

// How a room was created. MANUAL rooms (from إنشاء غرفة) are publicly listed and
// allow rejoin while open; QUICK_PLAY rooms are matchmaking-only — never listed
// and never rejoinable once a player leaves. This is the authoritative room-type
// flag; never infer the type from isPrivate or the room name.
enum GameKind {
  MANUAL
  QUICK_PLAY

  @@map("game_kind")
  @@schema("link_up")
}

enum GamePhase {
  LOBBY
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  RESOLVE
  ENDED

  @@map("game_phase")
  @@schema("link_up")
}

enum GamePlayerStatus {
  WAITING
  ACTIVE
  FOLDED
  ALLIN
  DISCONNECTED

  @@map("game_player_status")
  @@schema("link_up")
}

enum CardType {
  HOLE
  COMMUNITY

  @@map("card_type")
  @@schema("link_up")
}

enum BetRound {
  PREFLOP
  FLOP
  TURN
  RIVER

  @@map("bet_round")
  @@schema("link_up")
}

enum BetAction {
  ANTE
  CHECK
  CALL
  RAISE
  FOLD
  ALLIN

  @@map("bet_action")
  @@schema("link_up")
}

enum ResultOutcome {
  WIN
  SPLIT
  LOSE
  FOLD
  REFUND

  @@map("result_outcome")
  @@schema("link_up")
}

// Big-tournament categories tracked per player for the fame score (display/
// difficulty only — never used by the rank engine).
enum TournamentType {
  WORLD_CUP
  EURO_COPA
  CHAMPIONS_LEAGUE

  @@map("tournament_type")
  @@schema("football")
}

// Room difficulty — selects the fame_score floor the deal draws from (Part 3).
// Three levels: EASY (floor>=70), MEDIUM (floor>=50), ELITE (all active).
enum Difficulty {
  EASY
  MEDIUM
  ELITE

  @@map("difficulty")
  @@schema("link_up")
}

// ----------------------------------------------------------------------------
// Identity, wallet, stats (persistent)
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Sequential, starts at 100001 (sequence restart set in the init migration),
  // displayed as e.g. #100001.
  playerNumber Int      @unique @default(autoincrement()) @map("player_number")
  username     String   @unique
  // Editable display name (profile layer). NOT unique — `username`/`playerNumber`
  // remain the identifiers; null falls back to `username` for display.
  nickname     String?
  passwordHash String   @map("password_hash") // argon2id
  // Email + OTP verification. `email` is collected at signup and unique; nullable
  // ONLY so pre-existing rows (no email) stay valid — new signups always set it.
  // `emailVerifiedAt` is the login gate: NULL = unverified (login is blocked and
  // the user is routed to /verify). The init-verification migration backfills all
  // existing rows to now() so the handful of legacy/test accounts are grandfathered
  // as verified and never sent through the flow.
  email           String?   @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  avatarSeed   String?  @map("avatar_seed")
  // Social layer: denormalized total likes received (source of truth = Like rows).
  likesReceived Int     @default(0) @map("likes_received")
  // Inactivity auto-logout: last time this human showed activity (HTTP request or
  // socket event). Advanced by touchUserActivity (throttled); read at access to
  // expire sessions idle > SESSION_INACTIVITY_MS. Defaults to now() so existing
  // rows backfill to migration time (nobody is logged out on deploy). Bots have
  // a row too but it is never updated or checked (they never authenticate).
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  // One-time "add to home screen" reward: set when the 10k install reward is
  // granted (null = never claimed). Persists across uninstall/reinstall so the
  // reward can be granted at most once per account.
  installRewardAt DateTime? @map("install_reward_at") @db.Timestamptz(6)
  // Admin moderation: when set, the account is disabled (banned). Login is
  // blocked (web `authorize`) and the realtime handshake is rejected. Nullable;
  // null = active. Set/cleared only via the admin dashboard, audited.
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet       Wallet?
  stats        UserStats?
  metrics      PlayerMetrics?
  avatar       UserAvatar?
  transactions WalletTransaction[]
  bankClaims   BankClaim[]
  gamesCreated Game[]              @relation("GamesCreatedBy")
  gamePlayers  GamePlayer[]
  playEvents   PlayEvent[]
  playerBadges PlayerBadge[]
  likesGiven    Like[]       @relation("LikesGiven")
  likesGot      Like[]       @relation("LikesGot")
  friendReqSent Friendship[] @relation("FriendRequester")
  friendReqRecv Friendship[] @relation("FriendAddressee")
  emailOtp      EmailOtp?
  admin         Admin?

  @@map("users")
  @@schema("platform")
}

// One-time email-verification code (signup OTP). At most ONE active code per user
// (user_id is unique) — a re-request UPSERTS this row, so codes never accumulate;
// the row count is bounded by the number of currently-unverified users. The
// 6-digit code is stored ONLY as a hash (HMAC-SHA256 over AUTH_SECRET), never in
// plaintext. Lifecycle (data-hygiene): deleted on successful verify, and expired
// rows are purged opportunistically on each issue/verify. `expiresAt` is at most
// 5 minutes out; `attempts` caps brute-force guesses before the code is killed.
model EmailOtp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports the opportunistic purge (DELETE WHERE expires_at < now()).
  @@index([expiresAt])
  @@map("email_otps")
  @@schema("platform")
}

// Social — likes (one row per (liker, target); one-per-user toggle). Denormalized
// count lives on User.likesReceived, moved in lockstep with these rows.
model Like {
  id        String   @id @default(uuid()) @db.Uuid
  likerId   String   @map("liker_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  liker     User     @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  target    User     @relation("LikesGot", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([likerId, targetId])
  @@index([targetId])
  @@map("likes")
  @@schema("platform")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("friend_status")
  @@schema("platform")
}

// Social — directional friend request with an approval state machine. One row per
// (requester, addressee). A friendship is ACTIVE only when status=ACCEPTED.
// Overlapping/duplicate requests + self-requests are rejected/auto-handled in code.
model Friendship {
  id          String       @id @default(uuid()) @db.Uuid
  requesterId String       @map("requester_id") @db.Uuid
  addresseeId String       @map("addressee_id") @db.Uuid
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
  @@schema("platform")
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  // balance is updated ONLY in sync with inserting a WalletTransaction, inside
  // the same DB transaction. A CHECK(balance >= 0) is added in the migration.
  balance        BigInt   @default(1000)
  highestBalance BigInt   @default(1000) @map("highest_balance")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
  @@schema("link_up")
}

// Append-only ledger — the financial source of truth (Section 6).
model WalletTransaction {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  gameId       String?      @map("game_id") @db.Uuid
  type         WalletTxType
  amount       BigInt // positive = credit, negative = debit
  balanceAfter BigInt       @map("balance_after")
  reference    String       @unique // = server-generated idempotency key (actionId)
  metadata     Json?        @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  // Makes the SetNull during an abandoned-game delete index-driven (was a
  // seq-scan); also useful for any per-game ledger lookup. Additive.
  @@index([gameId])
  @@map("wallet_transactions")
  @@schema("link_up")
}

model BankClaim {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    BigInt   @default(1000)
  // Claim-log fields (level-based daily claim): the player's level at claim time
  // and the wallet balance right after crediting. Nullable — rows created before
  // this was introduced have neither. Filled by claimFromBank.
  level         Int?
  balanceAfter  BigInt?  @map("balance_after")
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, claimedAt])
  @@map("bank_claims")
  @@schema("link_up")
}

model UserStats {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  gamesPlayed    Int      @default(0) @map("games_played")
  wins           Int      @default(0)
  losses         Int      @default(0)
  folds          Int      @default(0)
  totalCoinsWon  BigInt   @default(0) @map("total_coins_won")
  totalCoinsLost BigInt   @default(0) @map("total_coins_lost")
  netProfitLoss  BigInt   @default(0) @map("net_profit_loss")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
  @@schema("link_up")
}

// Uploaded profile avatar (profile layer). Stored in the DB (Railway's filesystem
// is ephemeral) — small images only. Served by user_id so other players' avatars
// work later. Absent ⇒ the UI shows a generated avatar from `avatar_seed`.
model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  data      Bytes
  mimeType  String   @map("mime_type")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
  @@schema("platform")
}

// ============================================================================
// Statistics & progression (4-layer system). All keyed on the stable User.id,
// independent of any future profile layer. Append-only events (Layer 1) →
// incremental per-player metrics (Layer 2) → data-driven badges (Layer 3) →
// composite XP/level (Layer 4). Live play writes lightweight PlayEvent rows
// only; all aggregation runs after the hand, outside the betting hot path.
// ============================================================================

// Layer 1 — raw, append-only event log (same philosophy as the wallet ledger).
enum PlayEventType {
  BET // a wager: value = amount, metadata.potBefore for bet/pot ratio
  RAISE
  CALL
  CHECK
  FOLD
  ALLIN
  // One per dealt player at resolve — the unit the aggregator folds into
  // metrics. metadata carries the derived per-hand facts (won, folded, showdown,
  // rankStrength, dealtStrength, luck, maxBetToPot, isBluff, bluffWon, weakWon…).
  ROUND_SUMMARY

  @@map("play_event_type")
  @@schema("link_up")
}

model PlayEvent {
  // Monotonic watermark for incremental, idempotent aggregation.
  seq        BigInt        @id @default(autoincrement())
  playerId   String        @map("player_id") @db.Uuid
  gameId     String?       @map("game_id") @db.Uuid
  handNumber Int           @map("hand_number")
  type       PlayEventType
  value      Float?
  metadata   Json?         @db.JsonB
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  player     User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game       Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([playerId, seq])
  @@index([playerId, createdAt])
  @@index([gameId, handNumber])
  @@map("play_events")
  @@schema("link_up")
}

// Layer 2 — precomputed per-player read model. Updated AFTER a hand, incrementally
// (only over events past `lastSeq`). The stats page reads straight from here.
model PlayerMetrics {
  userId            String   @id @map("user_id") @db.Uuid
  matches           Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  folds             Int      @default(0)
  netProfit         BigInt   @default(0) @map("net_profit")
  totalWon          BigInt   @default(0) @map("total_won")
  totalLost         BigInt   @default(0) @map("total_lost")
  showdownCount     Int      @default(0) @map("showdown_count")
  bluffCount        Int      @default(0) @map("bluff_count")
  bluffSuccessCount Int      @default(0) @map("bluff_success_count")
  weakWonCount      Int      @default(0) @map("weak_won_count")
  // Sums for averages (kept incrementally so rates need no event re-scan).
  betToPotSum       Float    @default(0) @map("bet_to_pot_sum")
  betActionCount    Int      @default(0) @map("bet_action_count")
  luckSum           Float    @default(0) @map("luck_sum")
  luckRounds        Int      @default(0) @map("luck_rounds")
  biggestPot        BigInt   @default(0) @map("biggest_pot")
  // Biggest single-hand net win / loss (profile layer; filled by the aggregator).
  biggestWin        BigInt   @default(0) @map("biggest_win")
  biggestLoss       BigInt   @default(0) @map("biggest_loss")
  currentWinStreak  Int      @default(0) @map("current_win_streak")
  longestWinStreak  Int      @default(0) @map("longest_win_streak")
  // Layer 4 — composite progression.
  xp                BigInt   @default(0)
  level             Int      @default(1)
  // Highest level the player has already seen the "level up" celebration for.
  // The web shows the celebration when `level > celebrated_level`, then advances
  // this (server-authoritative, once per level-up). Defaults to 1; the migration
  // backfills existing rows to their current level so nobody is celebrated
  // retroactively.
  celebratedLevel   Int      @default(1) @map("celebrated_level")
  // Watermark: the highest PlayEvent.seq folded in so far (idempotent/incremental).
  lastSeq           BigInt   @default(0) @map("last_seq")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_metrics")
  @@schema("link_up")
}

// Layer 3 — data-driven badge definitions (same pattern as HandRank). Add a new
// badge by inserting a row — no code change. `rule` is the condition DSL over
// PlayerMetrics-derived fields.
model Badge {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  nameAr        String        @map("name_ar")
  descriptionAr String        @map("description_ar")
  icon          String        @default("🏅")
  sortOrder     Int           @default(0) @map("sort_order")
  active        Boolean       @default(true)
  rule          Json          @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  awards        PlayerBadge[]

  @@map("badges")
  @@schema("link_up")
}

// Awarded badges — idempotent (a badge is granted once per player).
model PlayerBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("player_badges")
  @@schema("link_up")
}

// ----------------------------------------------------------------------------
// Football reference data (data-driven; owner-supplied except Positions seed)
// ----------------------------------------------------------------------------

model Nationality {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  isoCode   String? @map("iso_code")
  flagEmoji String? @map("flag_emoji")
  // Arabic display name (Guess the Player Arabic-first search; usable by any
  // game). Display/search only — NEVER used by rules (which key on canonical
  // English identity). STRICT policy: shown/searched only when verified.
  nameAr         String? @map("name_ar")
  nameArVerified Boolean @default(false) @map("name_ar_verified")

  clubs     Club[]
  players   Player[]

  @@map("nationalities")
  @@schema("football")
}

// Curated country → football CONFEDERATION mapping (Guess the Player continent
// question). Membership by RULE, not geography — current confederation
// membership is the reference (Russia/Türkiye → UEFA, Australia → AFC since
// 2006, Kazakhstan → UEFA); includes non-FIFA confederation members present in
// the data (Réunion → CAF; Martinique/Guadeloupe/French Guiana → CONCACAF).
// Keys are the LITERAL nationality names as they appear in
// football.nationalities (near-duplicates like Türkiye/Turkey both seeded).
// Zero-error rule: a nationality missing here answers UNKNOWN, never a guess.
// Seeded by packages/db/prisma/seed-confederations.ts (audits coverage).
model CountryConfederation {
  /// The literal nationality name (football.nationalities.name).
  countryName String @id @map("country_name")
  /// UEFA | AFC | CAF | CONMEBOL | CONCACAF | OFC (checked in the seed).
  confederation String

  @@map("country_confederations")
  @@schema("football")
}

model Position {
  id      String       @id @default(uuid()) @db.Uuid
  code    PositionCode @unique
  nameAr  String       @map("name_ar")
  nameEn  String       @map("name_en")

  players Player[]

  @@map("positions")
  @@schema("football")
}

// Team entity type. Career history (player_clubs) holds ONLY kind=CLUB; national
// teams (senior/youth) and youth-club academies are split into their own link
// tables. Display/data only — the rank engine still keys on player_clubs.
enum ClubKind {
  CLUB
  NATIONAL_TEAM
  NATIONAL_YOUTH
  YOUTH_CLUB

  @@map("club_kind")
  @@schema("football")
}

model Club {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  countryId   String?      @map("country_id") @db.Uuid
  logoUrl     String?      @map("logo_url")
  // Entity type (see ClubKind): separates real clubs from national teams and
  // youth-club academies so career history can be clubs-only.
  kind        ClubKind     @default(CLUB)
  // Reserve / "B" / second team (e.g. "Barcelona B", "Real Madrid Castilla",
  // "Bayern II", "Jong Ajax"). A curation flag populated by
  // `pnpm db:classify-reserve-clubs` (name heuristics + manual edits). Consumed
  // ONLY by the Top Ten hint generator, which must reference a player's FIRST team,
  // never a reserve side. Additive & default false → NO effect on the Link Up rank
  // engine, fame scores, or career display, none of which read it.
  isReserve   Boolean      @default(false) @map("is_reserve")
  // Arabic display name (transliteration, e.g. "ريال مدريد") — display/search
  // only, never rules. Curated seed + LLM pipeline; STRICT policy: shown/
  // searched only when verified (see seed/generate/verify arabic-names scripts).
  nameAr         String? @map("name_ar")
  nameArVerified Boolean @default(false) @map("name_ar_verified")

  country       Nationality?         @relation(fields: [countryId], references: [id], onDelete: SetNull)
  playerClubs   PlayerClub[]
  nationalTeams PlayerNationalTeam[]
  youthClubs    PlayerYouthClub[]

  @@map("clubs")
  @@schema("football")
}

model Player {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  // Arabic display name (Batch 2). Display-only — NEVER used in rank logic, which
  // keys on nationality/position/clubs. Nullable so existing rows stay valid.
  nameAr        String?  @map("name_ar")
  // External provider id (e.g. API-Football player id). Idempotency key for the
  // one-time importer; null for manually-seeded players. Display/data only.
  externalRef   Int?     @unique @map("external_ref")
  nationalityId String   @map("nationality_id") @db.Uuid
  positionId    String   @map("position_id") @db.Uuid
  birthYear     Int?     @map("birth_year")
  photoUrl      String?  @map("photo_url")
  // Static per-player data imported from API-Football (display/data only — NEVER
  // used by the rank engine, which keys on nationality/position/clubs). All
  // nullable so existing rows stay valid until enriched.
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  birthDate     DateTime? @map("birth_date") @db.Date
  birthPlace    String?   @map("birth_place")
  birthCountry  String?   @map("birth_country")
  heightCm      Int?      @map("height_cm")
  weightKg      Int?      @map("weight_kg")
  active        Boolean  @default(true)
  // Legend flag (display/curation only — never used by the rank engine, wallet,
  // or card privacy). The fame-score "legend" component stays 0 for everyone
  // until that scoring rule is activated separately.
  isLegend      Boolean  @default(false) @map("is_legend")
  // Legend-card score: the raw fame_score mapped into the legend range
  // [80, 95] via 80 + 15*(fame_score/100); Messi=100, Ronaldo=99 override.
  // Null for non-legends. fame_score keeps the raw value untouched.
  legendScore   Float?   @map("legend_score")
  // Fame system (display + difficulty tiers only — NEVER used by the rank
  // engine, which keys on nationality/position/clubs). Filled by the import +
  // calculate scripts; both nullable/0 until then so existing rows stay valid.
  top5LeagueSeasons Int    @default(0) @map("top5_league_seasons")
  fameScore         Float? @map("fame_score")
  // Fame tier 1-4 (1 = most famous), derived from fame_score rank by
  // calculate-scores. Drives the difficulty dealing filter (Part 3).
  tier              Int?
  // Average API-Football match rating (~0-10) across all the player's rated
  // season/competition lines (player_season_stats.rating). Display/data only —
  // NEVER read by the rank engine. Null when the player has no rated season.
  avgRating         Float? @map("avg_rating")
  // How many rated season/competition lines that average is based on (sample
  // size). 0 when none. Lets rankings guard against tiny-sample flukes.
  avgRatingN        Int    @default(0) @map("avg_rating_n")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  nationality     Nationality            @relation(fields: [nationalityId], references: [id], onDelete: Restrict)
  position        Position               @relation(fields: [positionId], references: [id], onDelete: Restrict)
  playerClubs     PlayerClub[]
  nationalTeams   PlayerNationalTeam[]
  youthClubs      PlayerYouthClub[]
  tournamentStats PlayerTournamentStat[]
  seasonStats     PlayerSeasonStat[]
  gameCards       GameCard[]

  @@index([nationalityId])
  @@index([positionId])
  @@index([tier])
  // Prefix player-search for the Top Ten filtered input (read-only consumer; Top
  // Ten never writes football data). Additive btree indexes on the display-name
  // columns. NOTE: case-insensitive ILIKE prefix at 8k rows is already instant; a
  // pg_trgm GIN index would be the upgrade if the pool ever grows large.
  @@index([name])
  @@index([nameAr])
  @@map("players")
  @@schema("football")
}

// Arabic display names for competitions, keyed by the STABLE league_id — a
// separate table (not a column) because football.competition_dim is a raw
// table that build-totals drops and rebuilds; this survives every rebuild.
// TRANSLATION as used by Arabic sports media ("الدوري الإسباني"), sharing one
// glossary with the trophy whitelist so the same competition reads identically
// everywhere. STRICT policy: consumed only when verified.
model CompetitionNameAr {
  leagueId Int     @id @map("league_id")
  nameAr   String  @map("name_ar")
  verified Boolean @default(false)

  @@map("competition_names_ar")
  @@schema("football")
}

// Competition identity aliases (zero-error, same pattern as the trophy
// merges): when the source data records the SAME real competition under two
// league_ids (e.g. an API rename), the VARIANT id points at its canonical id;
// the resolver folds variants into asks as altLeagueIds and the picker hides
// variant ids. Curated ONLY by merge-competition-variants.ts. No such split
// is provable in the data today (verified 2026-07-06) — this table exists so
// the class is covered the moment one appears; the audit watches candidates.
model CompetitionAlias {
  leagueId          Int @id @map("league_id")
  canonicalLeagueId Int @map("canonical_league_id")

  @@map("competition_aliases")
  @@schema("football")
}

// One row per (player, tournament type) holding an appearance count, sourced by
// the API-Football tournament-stats import. Feeds COMPONENT 3 of the fame score.
model PlayerTournamentStat {
  id             String         @id @default(uuid()) @db.Uuid
  playerId       String         @map("player_id") @db.Uuid
  tournamentType TournamentType @map("tournament_type")
  appearances    Int            @default(0)

  player         Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentType])
  @@index([playerId])
  @@map("player_tournament_stats")
  @@schema("football")
}

// SEASON-/COMPETITION-dependent stats from API-Football's /players?id=&season=
// `statistics[]` — one row per (player, season, competition, team). Fully
// columnized (every nested field flattened) so the data is structured and
// searchable, nothing discarded. Display/data only — NEVER used by the rank
// engine, wallet, or card privacy. Mirrors our existing conventions (uuid PK,
// snake_case @@map, timestamptz). External ids are the API-Football ids.
model PlayerSeasonStat {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  season   Int

  // team + league/competition this stat line belongs to (API ids + display)
  teamId        Int?    @map("team_id")
  teamName      String? @map("team_name")
  teamLogo      String? @map("team_logo")
  leagueId      Int?    @map("league_id")
  leagueName    String? @map("league_name")
  leagueCountry String? @map("league_country")
  leagueLogo    String? @map("league_logo")
  leagueFlag    String? @map("league_flag")

  // games
  appearances Int?     @map("games_appearances")
  lineups     Int?     @map("games_lineups")
  minutes     Int?     @map("games_minutes")
  shirtNumber Int?     @map("games_number")
  position    String?  @map("games_position")
  rating      Float?   @map("games_rating")
  captain     Boolean? @map("games_captain")

  // substitutes
  subsIn    Int? @map("subs_in")
  subsOut   Int? @map("subs_out")
  subsBench Int? @map("subs_bench")

  // shots
  shotsTotal Int? @map("shots_total")
  shotsOn    Int? @map("shots_on")

  // goals
  goalsTotal    Int? @map("goals_total")
  goalsConceded Int? @map("goals_conceded")
  goalsAssists  Int? @map("goals_assists")
  goalsSaves    Int? @map("goals_saves")

  // passes
  passesTotal    Int? @map("passes_total")
  passesKey      Int? @map("passes_key")
  passesAccuracy Int? @map("passes_accuracy")

  // tackles
  tacklesTotal         Int? @map("tackles_total")
  tacklesBlocks        Int? @map("tackles_blocks")
  tacklesInterceptions Int? @map("tackles_interceptions")

  // duels
  duelsTotal Int? @map("duels_total")
  duelsWon   Int? @map("duels_won")

  // dribbles
  dribblesAttempts Int? @map("dribbles_attempts")
  dribblesSuccess  Int? @map("dribbles_success")
  dribblesPast     Int? @map("dribbles_past")

  // fouls
  foulsDrawn     Int? @map("fouls_drawn")
  foulsCommitted Int? @map("fouls_committed")

  // cards
  cardsYellow    Int? @map("cards_yellow")
  cardsYellowRed Int? @map("cards_yellowred")
  cardsRed       Int? @map("cards_red")

  // penalty
  penaltyWon       Int? @map("penalty_won")
  penaltyCommitted Int? @map("penalty_committed")
  penaltyScored    Int? @map("penalty_scored")
  penaltyMissed    Int? @map("penalty_missed")
  penaltySaved     Int? @map("penalty_saved")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, leagueId, teamId])
  @@index([playerId])
  @@index([season])
  @@index([leagueId])
  @@map("player_season_stats")
  @@schema("football")
}

model PlayerClub {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid
  fromYear Int?   @map("from_year")
  toYear   Int?   @map("to_year")

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([clubId])
  @@map("player_clubs")
  @@schema("football")
}

// National-team appearances (المنتخب), split out of player_clubs. Each row's
// club is a kind=NATIONAL_TEAM (senior) or NATIONAL_YOUTH entity. Preserved and
// queryable; not part of the club career history and not seen by the engine.
model PlayerNationalTeam {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubId])
  @@index([playerId])
  @@index([clubId])
  @@map("player_national_teams")
  @@schema("football")
}

// Youth-club academy appearances (e.g. "Real Madrid U19"), split out of
// player_clubs. Each row's club is a kind=YOUTH_CLUB entity. Preserved.
model PlayerYouthClub {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubId])
  @@index([playerId])
  @@index([clubId])
  @@map("player_youth_clubs")
  @@schema("football")
}

// Game rules, seeded. rule (jsonb) holds the Rule DSL (Section 7.3/7.4).
model HandRank {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  nameAr        String  @map("name_ar")
  nameEn        String  @map("name_en")
  strength      Int     @unique
  rule          Json    @db.JsonB
  descriptionAr String? @map("description_ar")
  examples      Json?   @db.JsonB
  active        Boolean @default(true)

  claimsAsClaimed PlayerHandClaim[] @relation("ClaimedHandRank")
  claimsAsBest    PlayerHandClaim[] @relation("BestPossibleRank")

  @@map("hand_ranks")
  @@schema("link_up")
}

// ----------------------------------------------------------------------------
// Game session (rooms are temporary; results/ledger are persistent)
// ----------------------------------------------------------------------------

model Game {
  id              String     @id @default(uuid()) @db.Uuid
  roomName        String     @map("room_name")
  isPrivate       Boolean    @default(false) @map("is_private")
  kind            GameKind   @default(MANUAL)
  maxPlayers      Int        @map("max_players")
  inviteCode      String     @unique @map("invite_code")
  status          GameStatus @default(LOBBY)
  difficulty      Difficulty @default(MEDIUM)
  createdBy       String     @map("created_by") @db.Uuid
  config          Json       @db.JsonB
  phase           GamePhase  @default(LOBBY)
  pot             BigInt     @default(0) // display total
  pots            Json?      @db.JsonB // side pots at resolve: [{ amount, eligibleSeats[] }]
  currentBet      BigInt     @default(0) @map("current_bet")
  dealerSeat      Int?       @map("dealer_seat")
  currentTurnSeat Int?       @map("current_turn_seat")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(6)

  creator         User       @relation("GamesCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  players         GamePlayer[]
  cards           GameCard[]
  bets            Bet[]
  handClaims      PlayerHandClaim[]
  results         GameResult[]
  transactions    WalletTransaction[]
  playEvents      PlayEvent[]

  // Supports the abandoned-room cleanup selection (status='ABANDONED' AND
  // ended_at < cutoff). Additive; no data change.
  @@index([status, endedAt])
  @@map("games")
  @@schema("link_up")
}

model GamePlayer {
  id                 String           @id @default(uuid()) @db.Uuid
  gameId             String           @map("game_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  seat               Int
  status             GamePlayerStatus @default(WAITING)
  holeCards          Json?            @map("hole_cards") @db.JsonB // server only, never broadcast
  committedTotal     BigInt           @default(0) @map("committed_total")
  committedThisRound BigInt           @default(0) @map("committed_this_round")
  lastBetAmount      BigInt           @default(0) @map("last_bet_amount")
  joinedAt           DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime?        @map("left_at") @db.Timestamptz(6)

  game               Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets               Bet[]
  handClaims         PlayerHandClaim[]
  results            GameResult[]

  @@unique([gameId, seat])
  @@unique([gameId, userId])
  @@map("game_players")
  @@schema("link_up")
}

model GameCard {
  id               String   @id @default(uuid()) @db.Uuid
  gameId           String   @map("game_id") @db.Uuid
  cardType         CardType @map("card_type")
  ownerSeat        Int?     @map("owner_seat")
  communityIndex   Int?     @map("community_index") // 0-4
  footballPlayerId String   @map("football_player_id") @db.Uuid
  revealed         Boolean  @default(false)

  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  footballPlayer   Player   @relation(fields: [footballPlayerId], references: [id], onDelete: Restrict)

  @@index([gameId])
  @@map("game_cards")
  @@schema("link_up")
}

model Bet {
  id           String    @id @default(uuid()) @db.Uuid
  gameId       String    @map("game_id") @db.Uuid
  gamePlayerId String    @map("game_player_id") @db.Uuid
  round        BetRound
  action       BetAction
  amount       BigInt
  sequence     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("bets")
  @@schema("link_up")
}

model PlayerHandClaim {
  id                 String   @id @default(uuid()) @db.Uuid
  gameId             String   @map("game_id") @db.Uuid
  gamePlayerId       String   @map("game_player_id") @db.Uuid
  claimedHandRankId  String?  @map("claimed_hand_rank_id") @db.Uuid
  isValid            Boolean  @map("is_valid")
  bestPossibleRankId String?  @map("best_possible_rank_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  game               Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer         GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  claimedHandRank    HandRank?  @relation("ClaimedHandRank", fields: [claimedHandRankId], references: [id], onDelete: SetNull)
  bestPossibleRank   HandRank?  @relation("BestPossibleRank", fields: [bestPossibleRankId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@map("player_hand_claims")
  @@schema("link_up")
}

model GameResult {
  id           String        @id @default(uuid()) @db.Uuid
  gameId       String        @map("game_id") @db.Uuid
  gamePlayerId String        @map("game_player_id") @db.Uuid
  outcome      ResultOutcome
  coinsDelta   BigInt        @map("coins_delta")
  finalBalance BigInt        @map("final_balance")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_results")
  @@schema("link_up")
}

// ----------------------------------------------------------------------------
// Admin authority (platform-owned; super-admin dashboard — Proposal 2, Phase 0)
// Lives in the `platform` schema because an admin is a PLATFORM fact, keyed on
// the opaque user_id (the cross-game identity contract): any current/future game
// inherits the same admin identity. These tables are read ONLY by the admin
// dashboard, never by gameplay, so they never touch the live-game hot path.
// ----------------------------------------------------------------------------

// Two FIXED tiers. The extensible axis is PERMISSIONS (string keys in
// @fb/shared), NOT this enum — adding a capability needs no migration.
enum AdminRole {
  SUPER_ADMIN
  ADMIN

  @@map("admin_role")
  @@schema("platform")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED

  @@map("admin_status")
  @@schema("platform")
}

// One row per admin. SUPER_ADMIN has implicit all-permissions; ADMIN holds only
// the explicit grants in admin_permissions. Anti-lockout rules (never remove the
// last active super-admin, etc.) are enforced in @fb/admin-core, not the schema.
model Admin {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @unique @map("user_id") @db.Uuid
  role            AdminRole
  status          AdminStatus @default(ACTIVE)
  grantedByUserId String?     @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz(6)

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions     AdminPermission[]

  @@index([role])
  @@map("admins")
  @@schema("platform")
}

// Per-admin permission grants (only meaningful for ADMIN; SUPER_ADMIN bypasses).
// `permissionKey` is a string from the @fb/shared PERMISSIONS registry — kept as
// a string (NOT a Postgres enum) so a new capability is add-a-row, no migration.
// `scope` lets a grant target the platform or a specific game (e.g. "link_up").
model AdminPermission {
  id              String   @id @default(uuid()) @db.Uuid
  adminId         String   @map("admin_id") @db.Uuid
  permissionKey   String   @map("permission_key")
  scope           String   @default("platform")
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin           Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionKey, scope])
  @@index([adminId])
  @@map("admin_permissions")
  @@schema("platform")
}

// Append-only audit log of every admin action. Intentionally has NO foreign key
// to users so the history survives even if an actor account is later deleted —
// audit must be immutable. Queried ONLY by the dashboard; append-only + indexed,
// so it can grow without ever touching the live game (retention added later).
model AdminAuditLog {
  seq         BigInt   @id @default(autoincrement())
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  scope       String?
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  metadata    Json?    @db.JsonB
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
  @@schema("platform")
}

// ============================================================================
// Top Ten (توب 10) — game #2 (binding contract: docs/architecture/PLATFORM_CONTRACTS.md).
// Lives in its OWN `top_10` schema (group C+D for this game). ISOLATION RULES honored:
//   • References platform identity by opaque `user_id` UUID only — NO FK to platform.users.
//   • References football reference data by `football_player_id` UUID only — NO FK to
//     football.players (football is read through the seam; this keeps a future separate
//     DB / network football API possible without a cross-DB foreign key).
//   • FKs exist ONLY between top_10's own tables.
// Top Ten NEVER writes football.* or any link_up.* table.
// ============================================================================

// The eight stat types. Active set is GOAL_SCORERS / ASSISTS / KEY_PASSES / TACKLES /
// ACCURATE_PASSES. GK_CLEAN_SHEETS is wired but DORMANT (deferred D1 — no clean-sheets
// data yet; becomes generatable the moment that column is imported, no schema change).
// Club/national-team types (D3) are deferred to a later team-guessing version.
enum TtQuestionType {
  GOAL_SCORERS
  ASSISTS
  KEY_PASSES // midfielders only
  TACKLES
  ACCURATE_PASSES // midfielders only
  GK_CLEAN_SHEETS
  KEY_PASSES_ALL // all players (no position filter)
  ACCURATE_PASSES_ALL // all players (no position filter)
  SHOTS_TOTAL // all players
  SHOTS_ON // all players
  DRIBBLES_SUCCESS // all players
  GK_SAVES // goalkeepers only

  @@map("tt_question_type")
  @@schema("top_10")
}

// Three difficulty tiers — derived from the Σ fame_score of the question's 10 players
// (inverse: high Σ = famous = EASY). Quick-play has one queue per tier; created rooms
// pick one freely. Own enum (not Link Up's) to keep the game schema-isolated.
enum TtDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("tt_difficulty")
  @@schema("top_10")
}

enum TtMatchKind {
  MANUAL
  QUICK_PLAY

  @@map("tt_match_kind")
  @@schema("top_10")
}

enum TtMatchStatus {
  LOBBY
  IN_PROGRESS
  ENDED
  ABANDONED

  @@map("tt_match_status")
  @@schema("top_10")
}

enum TtMatchPlayerStatus {
  ACTIVE
  WITHDRAWN

  @@map("tt_match_player_status")
  @@schema("top_10")
}

enum TtRoundMode {
  NORMAL
  HINT

  @@map("tt_round_mode")
  @@schema("top_10")
}

enum TtRoundStatus {
  ACTIVE
  ENDED

  @@map("tt_round_status")
  @@schema("top_10")
}

enum TtRoundEndReason {
  ALL_REVEALED
  UNANIMOUS_END
  TIMER
  WITHDRAWAL

  @@map("tt_round_end_reason")
  @@schema("top_10")
}

// ---- Question catalog (frozen, owner-reviewable snapshot) -------------------
// Built admin-time by the catalog script: it applies the completeness gate to every
// (type, competition, season) candidate and persists ONLY admitted lists. Runtime
// reads these rows — it NEVER re-ranks from football.* — so a mid-season data change
// can't alter a live match and there is no hot-path scan.
model TtCatalogEntry {
  id              String         @id @default(uuid()) @db.Uuid
  type            TtQuestionType
  // Variety SCOPE (the "where/who"): COMP = one competition; TOP5 = the five big
  // European leagues combined; CLUB_LEAGUE / CLUB_UCL / CLUB_ALL = one club within its
  // domestic league / the Champions League / all its competitions. `clubKey` (one of
  // TT_CLUBS) is set only for the CLUB_* scopes. `leagueId` is the competition for COMP,
  // the club's domestic league for CLUB_LEAGUE/CLUB_ALL, the UCL id for CLUB_UCL, and 0
  // for TOP5 — the audit re-derives the exact league set from (scope, leagueId, clubKey).
  scope           String         @default("COMP")
  clubKey         String?        @map("club_key")
  leagueId        Int            @map("league_id")
  competitionName String         @map("competition_name")
  // Season WINDOW: `season` is the first season, `seasonEnd` the last. They are equal
  // for a single-season question; seasonEnd > season for a cumulative range (e.g.
  // 2020–2022). Always populated by the builder.
  season          Int
  seasonEnd       Int?           @map("season_end")
  difficulty      TtDifficulty
  fameSum         Float          @map("fame_sum")
  // The build run that produced this entry (lets a rebuild supersede a prior catalog
  // without deleting history; runtime selects active=true).
  builtAt         DateTime       @default(now()) @map("built_at") @db.Timestamptz(6)
  active          Boolean        @default(true)

  players         TtCatalogPlayer[]

  // One admitted list per (type, scope, club, competition, season window) per build generation.
  @@unique([type, scope, clubKey, leagueId, season, seasonEnd, builtAt])
  @@index([active, difficulty])
  @@map("tt_catalog_entry")
  @@schema("top_10")
}

// The correct 10 answers for a catalog entry (rank 1..10). `footballPlayerId` is a
// plain UUID into football.players — intentionally NOT a Prisma relation (isolation).
model TtCatalogPlayer {
  id               String  @id @default(uuid()) @db.Uuid
  entryId          String  @map("entry_id") @db.Uuid
  rank             Int // 1 (top) .. 10; rank 10 may be SHARED by a cutoff tie group
  footballPlayerId String  @map("football_player_id") @db.Uuid
  value            Float // the stat value at build time
  fameAtBuild      Float   @map("fame_at_build")

  entry            TtCatalogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // A rank is NOT unique within an entry: the cutoff rank (10) may be shared by
  // several players tied on the stat value (each a valid rank-10 answer). What is
  // unique is a player appearing at most once per entry.
  @@unique([entryId, footballPlayerId])
  @@index([entryId, rank])
  @@map("tt_catalog_player")
  @@schema("top_10")
}

// Singleton-ish config: the two tercile thresholds on Σ fame that map a list to a
// difficulty tier. Latest row (by builtAt) is authoritative. Recomputed on rebuild.
model TtDifficultyConfig {
  id           String   @id @default(uuid()) @db.Uuid
  // Σ fame >= easyMinSum → EASY; Σ fame < hardMaxSum → HARD; between → MEDIUM.
  easyMinSum   Float    @map("easy_min_sum")
  hardMaxSum   Float    @map("hard_max_sum")
  entriesCount Int      @map("entries_count")
  builtAt      DateTime @default(now()) @map("built_at") @db.Timestamptz(6)

  @@map("tt_difficulty_config")
  @@schema("top_10")
}

// ---- Live session (rooms temporary; results/progression persistent) --------

model TtMatch {
  id            String        @id @default(uuid()) @db.Uuid
  kind          TtMatchKind   @default(MANUAL)
  difficulty    TtDifficulty  @default(MEDIUM)
  roundTimerSec Int           @default(600) @map("round_timer_sec") // 10 min default
  roundsTotal   Int           @default(3) @map("rounds_total") // fixed at 3
  maxPlayers    Int           @default(4) @map("max_players")
  status        TtMatchStatus @default(LOBBY)
  inviteCode    String?       @unique @map("invite_code")
  createdByUserId String      @map("created_by_user_id") @db.Uuid // opaque platform id
  config        Json          @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt     DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(6)

  players       TtMatchPlayer[]
  rounds        TtRound[]

  @@index([status, endedAt])
  @@map("tt_matches")
  @@schema("top_10")
}

model TtMatchPlayer {
  id          String              @id @default(uuid()) @db.Uuid
  matchId     String              @map("match_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid // opaque platform id (no FK)
  seat        Int
  totalPoints Int                 @default(0) @map("total_points")
  status      TtMatchPlayerStatus @default(ACTIVE)
  // Bot seats (quick-play only) are flagged so progression/XP writes can skip them,
  // mirroring Link Up's bot ledger/stats isolation. A bot's user_id is a reserved
  // player-number user row (>= 900000) in platform.users.
  isBot       Boolean             @default(false) @map("is_bot")
  withdrawnAt DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  joinedAt    DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)

  match       TtMatch             @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seat])
  @@unique([matchId, userId])
  @@map("tt_match_players")
  @@schema("top_10")
}

model TtRound {
  id                 String            @id @default(uuid()) @db.Uuid
  matchId            String            @map("match_id") @db.Uuid
  roundNo            Int               @map("round_no") // 1..3
  // The frozen catalog entry that supplies the 10 correct answers for this round.
  catalogEntryId     String?           @map("catalog_entry_id") @db.Uuid
  mode               TtRoundMode       @default(NORMAL)
  status             TtRoundStatus     @default(ACTIVE)
  // Full rotations with zero correct guesses; at 2 the round switches to HINT mode.
  noCorrectRotations Int               @default(0) @map("no_correct_rotations")
  endReason          TtRoundEndReason? @map("end_reason")
  startedAt          DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?         @map("ended_at") @db.Timestamptz(6)

  match              TtMatch           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reveals            TtRoundReveal[]

  @@unique([matchId, roundNo])
  @@index([matchId])
  @@map("tt_rounds")
  @@schema("top_10")
}

// One row per revealed card. Drives scoring AND the high-rank-first standings
// tiebreak (poker-style). `revealedByUserId` null = auto-revealed (3-hint exhaustion),
// nobody scored. `footballPlayerId` is the answer that was revealed.
model TtRoundReveal {
  id               String   @id @default(uuid()) @db.Uuid
  roundId          String   @map("round_id") @db.Uuid
  rank             Int // 1..10 — also the points value
  revealedByUserId String?  @map("revealed_by_user_id") @db.Uuid
  points           Int // = rank, or 0 for an auto-reveal
  footballPlayerId String   @map("football_player_id") @db.Uuid
  revealedAt       DateTime @default(now()) @map("revealed_at") @db.Timestamptz(6)

  round            TtRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, rank])
  @@index([roundId])
  @@map("tt_round_reveals")
  @@schema("top_10")
}

// ---- Progression (XP + cosmetic level) — per-game, no platform-wide economy ----

// Layer-2 read model (mirrors Link Up's player_metrics pattern). Keyed on opaque
// user_id. No coins/wallet/bank — XP and a cosmetic level only.
model TtProgression {
  userId          String   @id @map("user_id") @db.Uuid
  xp              BigInt   @default(0)
  level           Int      @default(1)
  celebratedLevel Int      @default(1) @map("celebrated_level")
  matchesPlayed   Int      @default(0) @map("matches_played")
  matchesWon      Int      @default(0) @map("matches_won")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tt_progression")
  @@schema("top_10")
}

// Append-only XP ledger (audit + idempotent aggregation source). `reference` is a
// server-generated idempotency key so re-applying the same award is a no-op.
model TtXpEvent {
  seq       BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  matchId   String?  @map("match_id") @db.Uuid
  amount    Int
  reason    String // ROUND_POINTS | TAIL_BONUS | MATCH_WIN
  reference String   @unique
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("tt_xp_events")
  @@schema("top_10")
}

// ============================================================================
// Guess the Player (خمن اللاعب) — game #3 (binding contract:
// docs/architecture/PLATFORM_CONTRACTS.md). Lives in its OWN `guess_player`
// schema (this game's group C+D). ISOLATION RULES honored, mirroring Top Ten:
//   • Platform identity referenced by opaque `user_id` UUID only — NO FK to platform.users.
//   • Football reference data referenced by `football_player_id` / raw league ids
//     only — NO FK to football.* (keeps a future separate DB possible).
//   • FKs exist ONLY between guess_player's own tables.
// Guess the Player NEVER writes football.* or any other game's tables.
//
// SECRECY INVARIANT: gp_rounds.hidden_player_id is server/DB-side only. It is
// NEVER emitted to any client (including /internal/rooms) before the reveal.
// ============================================================================

enum GpMode {
  VS_SYSTEM // system picks the hidden player (quick play is ALWAYS this)
  VS_HUMANS // a picker chooses via full-DB search (created rooms only)

  @@map("gp_mode")
  @@schema("guess_player")
}

enum GpMatchKind {
  MANUAL
  QUICK_PLAY

  @@map("gp_match_kind")
  @@schema("guess_player")
}

enum GpMatchStatus {
  LOBBY
  IN_PROGRESS
  ENDED
  ABANDONED

  @@map("gp_match_status")
  @@schema("guess_player")
}

// VS_SYSTEM hidden-player pool tiers over football.player_score.score:
// EASY floor(score)>=70, MEDIUM 50–69, HARD 35–49; <35 never dealt by the
// system (still pickable by a human picker). Own enum — schema isolation.
enum GpDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("gp_difficulty")
  @@schema("guess_player")
}

enum GpMatchPlayerStatus {
  ACTIVE
  WITHDRAWN

  @@map("gp_match_player_status")
  @@schema("guess_player")
}

enum GpRoundStatus {
  ACTIVE
  ENDED

  @@map("gp_round_status")
  @@schema("guess_player")
}

enum GpRoundEndReason {
  CORRECT_GUESS
  TIMER // 10 minutes, nobody guessed → reveal, VS_HUMANS picker survival bonus
  ABANDONED // all contestants gone / match closed mid-round

  @@map("gp_round_end_reason")
  @@schema("guess_player")
}

// The 9 question templates. Playing position and physical appearance are
// FORBIDDEN topics enforced by ABSENCE: no template for them exists, so the
// question system itself cannot ask them (locked rule).
enum GpQuestionTemplate {
  CLUB_EVER
  CLUB_SEASON
  NATIONALITY
  NATIONAL_TEAM
  CONTINENT
  COMPETITION_EVER
  COMPETITION_SEASON
  TROPHY_EVER
  TROPHY_SEASON
  TROPHY_WITH_CLUB

  @@map("gp_question_template")
  @@schema("guess_player")
}

// Three-valued answer (zero-error contract): YES/NO only when the data proves
// it; UNKNOWN = "لا يمكن الإجابة" and the asker's turn is NOT consumed.
enum GpAnswerValue {
  YES
  NO
  UNKNOWN

  @@map("gp_answer_value")
  @@schema("guess_player")
}

// ---- Askable-trophy whitelist (curated, data-driven — edit rows, not code) --
// Seeded from football.trophy_dim (non-youth categories) by seed-gp-trophies.
// The question composer's trophy autocomplete reads active rows only; the
// engine itself can verify ANY trophy — this table is UX scope, not truth.
model GpAskableTrophy {
  id        String   @id @default(uuid()) @db.Uuid
  // trophy_dim identity (comp_name, country) — country may be empty.
  compName  String   @map("comp_name")
  country   String   @default("")
  // trophy_dim category at seed time (UCL / LEAGUE_* / CLUB_CUP / OTHER_LEAGUE
  // / NATIONAL_SENIOR) — drives default ordering in the picker.
  category  String
  // Arabic display label (shared glossary with competition_names_ar; null →
  // show comp_name). STRICT policy: shown/searched only when verified.
  nameAr         String?  @map("name_ar")
  nameArVerified Boolean  @default(false) @map("name_ar_verified")
  // Identity aliasing (zero-error fix, 2026-07-06): the source data records
  // the SAME real trophy under variant strings ("World Cup" vs "FIFA World
  // Cup" — winners split 19/72). A variant row points at its canonical row
  // and is deactivated (not pickable); the resolver folds every variant's
  // (comp_name, country) into the ask as altKeys so the engine matches ALL
  // equivalent identities. Curated by merge-trophy-variants.ts only.
  mergedIntoId   String?  @map("merged_into_id") @db.Uuid
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  seededAt  DateTime @default(now()) @map("seeded_at") @db.Timestamptz(6)

  @@unique([compName, country])
  @@index([active, sortOrder])
  @@map("gp_askable_trophies")
  @@schema("guess_player")
}

// ---- Live session (rooms temporary; results/progression persistent) --------

model GpMatch {
  id              String        @id @default(uuid()) @db.Uuid
  kind            GpMatchKind   @default(MANUAL)
  mode            GpMode        @default(VS_SYSTEM)
  // Tier of the system picker — VS_SYSTEM only; null for VS_HUMANS.
  difficulty      GpDifficulty?
  // REPURPOSED (open-ended sessions): rounds actually PLAYED, written once at
  // session close — analytics only, no gameplay meaning. Column kept as-is.
  roundsTotal     Int           @default(3) @map("rounds_total")
  roundTimerSec   Int           @default(600) @map("round_timer_sec") // 10 min
  turnTimerSec    Int           @default(30) @map("turn_timer_sec")
  maxPlayers      Int           @default(4) @map("max_players") // rooms 2–6, quick play 2–4
  status          GpMatchStatus @default(LOBBY)
  inviteCode      String?       @unique @map("invite_code")
  isPrivate       Boolean       @default(false) @map("is_private")
  roomName        String?       @map("room_name")
  createdByUserId String        @map("created_by_user_id") @db.Uuid // opaque platform id
  config          Json          @db.JsonB
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)

  players         GpMatchPlayer[]
  rounds          GpRound[]

  // Supports the unified cleanup selection (status + ended_at cutoff).
  @@index([status, endedAt])
  @@map("gp_matches")
  @@schema("guess_player")
}

model GpMatchPlayer {
  id          String              @id @default(uuid()) @db.Uuid
  matchId     String              @map("match_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid // opaque platform id (no FK)
  seat        Int
  totalPoints Int                 @default(0) @map("total_points")
  status      GpMatchPlayerStatus @default(ACTIVE)
  withdrawnAt DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  joinedAt    DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)

  match       GpMatch             @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seat])
  @@unique([matchId, userId])
  @@map("gp_match_players")
  @@schema("guess_player")
}

model GpRound {
  id             String            @id @default(uuid()) @db.Uuid
  matchId        String            @map("match_id") @db.Uuid
  roundNo        Int               @map("round_no")
  // SECRET until reveal — plain UUID into football.players (no FK, isolation).
  hiddenPlayerId String            @map("hidden_player_id") @db.Uuid
  // VS_HUMANS: who picked the hidden player (cannot ask or guess this round);
  // null for VS_SYSTEM rounds.
  pickerUserId   String?           @map("picker_user_id") @db.Uuid
  status         GpRoundStatus     @default(ACTIVE)
  endReason      GpRoundEndReason? @map("end_reason")
  winnerUserId   String?           @map("winner_user_id") @db.Uuid
  // Points credited at resolve (winner / picker share / survival bonus live in
  // gp_xp_events with reasons; this is the winner's figure for the result UI).
  winnerPoints   Int               @default(0) @map("winner_points")
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?         @map("ended_at") @db.Timestamptz(6)

  match          GpMatch           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  questions      GpQuestion[]
  guesses        GpGuess[]

  @@unique([matchId, roundNo])
  @@index([matchId])
  @@map("gp_rounds")
  @@schema("guess_player")
}

// Every asked question WITH its answer (approved): audit trail for any
// disputed answer, the post-round history reveal, and question analytics.
model GpQuestion {
  id          String             @id @default(uuid()) @db.Uuid
  roundId     String             @map("round_id") @db.Uuid
  turnNo      Int                @map("turn_no")
  askerUserId String             @map("asker_user_id") @db.Uuid
  template    GpQuestionTemplate
  // The template's resolved entity params AS ASKED, with display labels frozen
  // at ask time (e.g. { clubId, clubName, season }) — self-contained history
  // even if reference data changes later.
  params      Json               @db.JsonB
  answer      GpAnswerValue
  askedAt     DateTime           @default(now()) @map("asked_at") @db.Timestamptz(6)

  round       GpRound            @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, turnNo])
  @@map("gp_questions")
  @@schema("guess_player")
}

model GpGuess {
  id               String   @id @default(uuid()) @db.Uuid
  roundId          String   @map("round_id") @db.Uuid
  guesserUserId    String   @map("guesser_user_id") @db.Uuid
  // The guessed player — selected via search, submitted as id (no free text).
  footballPlayerId String   @map("football_player_id") @db.Uuid
  correct          Boolean
  attemptNo        Int      @map("attempt_no") // 1..3 per contestant per round
  guessedAt        DateTime @default(now()) @map("guessed_at") @db.Timestamptz(6)

  round            GpRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@map("gp_guesses")
  @@schema("guess_player")
}

// ---- Progression (points → XP + cosmetic level) — per-game, no coins -------

model GpProgression {
  userId          String   @id @map("user_id") @db.Uuid
  xp              BigInt   @default(0)
  level           Int      @default(1)
  celebratedLevel Int      @default(1) @map("celebrated_level")
  matchesPlayed   Int      @default(0) @map("matches_played")
  matchesWon      Int      @default(0) @map("matches_won")
  roundsWon       Int      @default(0) @map("rounds_won")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("gp_progression")
  @@schema("guess_player")
}

// Append-only XP/points ledger (audit + idempotent aggregation source).
// reason: ROUND_WIN | PICKER_SHARE | SURVIVAL_BONUS | MATCH_WIN.
model GpXpEvent {
  seq       BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  matchId   String?  @map("match_id") @db.Uuid
  amount    Int
  reason    String
  reference String   @unique // server-generated idempotency key
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("gp_xp_events")
  @@schema("guess_player")
}
