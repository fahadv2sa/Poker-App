# Top Ten game-server (Socket.IO) — separate Railway service from Link Up.
# Shares the platform identity secret + the shared Postgres (reads football data
# read-only, owns the top_10 schema). PORT is injected by Railway in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Must EQUAL the web app's AUTH_SECRET (the cross-game identity contract).
AUTH_SECRET=change-me-must-match-web
# Allowed browser origin (the Top Ten web app).
WEB_ORIGIN=http://localhost:3100
GAME_SERVER_PORT=4100
# Quick-play bot fillers (cold-start). Unset/false = no bots.
BOTS_ENABLED=false
