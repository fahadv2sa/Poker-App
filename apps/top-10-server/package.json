{
  "name": "@fb/top-10-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fb/db": "workspace:*",
    "@fb/shared": "workspace:*",
    "@fb/top-10-engine": "workspace:*",
    "jose": "^6.2.3",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
