# Top Ten web app (Next.js) — separate Railway service from Link Up.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# MUST equal the Top Ten server's AUTH_SECRET AND (for one shared identity) Link Up's.
AUTH_SECRET=change-me-must-match-server
AUTH_URL=http://localhost:3100
# Public URL of the Top Ten Socket.IO server (baked in at build time).
NEXT_PUBLIC_TOP10_SERVER_URL=http://localhost:4100
