# apps/web — production environment (Railway service "web").
# Copy these into the Railway "web" service → Variables. Never commit real secrets.

# Railway PostgreSQL connection string. On Railway PG, DATABASE_URL and DIRECT_URL
# are the SAME value. (Future Neon: use the POOLED string here, DIRECT below.)
DATABASE_URL=<Railway PostgreSQL connection string — pooled if using Neon in future, direct for Railway PG>
DIRECT_URL=<Railway PostgreSQL direct connection string — same as DATABASE_URL for Railway PG>

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
# MUST be byte-for-byte identical to the game-server's AUTH_SECRET.
AUTH_SECRET=<32-byte base64 — must be identical to game-server>

# Public base URL of the web app.
AUTH_URL=https://poker.fmgtech.dev

# Public URL of the Socket.IO game server. Baked into the client bundle at BUILD
# time, so it must be set before the web service builds.
NEXT_PUBLIC_GAME_SERVER_URL=https://poker-rt.fmgtech.dev
