# @fp/web — copy to apps/web/.env.local
DATABASE_URL="postgresql://football:football@localhost:5432/football_poker?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"

# Base URL of the web app (used by Auth.js).
AUTH_URL="http://localhost:3000"

# Game server (Socket.IO) URL the browser connects to (Phase 4 live table).
NEXT_PUBLIC_GAME_SERVER_URL="http://localhost:4000"
