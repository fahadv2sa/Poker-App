# @fp/game-server — copy to apps/game-server/.env.local
DATABASE_URL="postgresql://football:football@localhost:5432/football_poker?schema=public"

# MUST be byte-for-byte identical to the web app's AUTH_SECRET (apps/web/.env*).
# The web signs the Socket.IO session token with it; the game server verifies it.
# If these two values drift, every socket connection is rejected.
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"

# Port the Socket.IO server listens on.
GAME_SERVER_PORT="4000"

# Allowed CORS origin (the web app).
WEB_ORIGIN="http://localhost:3000"
