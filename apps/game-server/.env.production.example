# apps/game-server — production environment (Railway service "game-server").
# Copy these into the Railway "game-server" service → Variables.

# Railway PostgreSQL connection string (same value for both on Railway PG).
DATABASE_URL=<Railway PostgreSQL connection string>
DIRECT_URL=<same as DATABASE_URL for Railway PG>

# MUST be byte-for-byte identical to the web app's AUTH_SECRET. The web signs the
# Socket.IO session token with it; the game server verifies it. If these drift,
# every socket connection is rejected.
AUTH_SECRET=<32-byte base64 — must be identical to web>

# Allowed CORS origin (the web app's public URL).
WEB_ORIGIN=https://poker.fmgtech.dev

# PORT is injected automatically by Railway — do not set it manually.
