{
  "name": "@fp/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run -c vitest.smoke.config.ts"
  },
  "dependencies": {
    "@fp/db": "workspace:*",
    "@fp/engine": "workspace:*",
    "@fp/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^6.2.3",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
